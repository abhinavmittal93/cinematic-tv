<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/row_bg"
    android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="14dp" android:paddingEnd="12dp">
    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="20dp" android:layout_height="20dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" android:tint="@color/on_glass" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:duplicateParentState="true" android:orientation="vertical">
        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/on_glass" android:textSize="13sp" />
        <TextView
            android:id="@+id/rowSub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:maxLines="1" android:textColor="@color/on_glass_secondary" android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
    <View
        android:id="@+id/rowDot"
        android:layout_width="8dp" android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/dot" android:visibility="gone" />
    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="16dp" android:layout_height="16dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron" android:tint="@color/on_glass_secondary" />
</LinearLayout>
